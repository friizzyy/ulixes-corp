# Ulixes Corporation Website
# Environment Variables

# Contact form delivery (required wherever the contact form is enabled)
RESEND_API_KEY=re_replace_with_your_resend_api_key

# reCAPTCHA v3 (required in production; requests fail closed without the secret)
# The Next.js config exposes RECAPTCHA_SITE_KEY to the browser as
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY. Never expose the secret key.
RECAPTCHA_SITE_KEY=replace_with_your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=replace_with_your_recaptcha_secret_key

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=
